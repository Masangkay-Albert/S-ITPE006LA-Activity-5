@model S_ITPE006LA___Activity_5.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<h1>Delete Product</h1>
<h3 class="text-danger">Are you sure you want to delete this product?</h3>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">SKU</dt>
        <dd class="col-sm-9"><code>@Model.SKU</code></dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

        <dt class="col-sm-3">Stock Quantity</dt>
        <dd class="col-sm-9">@Model.StockQuantity</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </form>
</div>