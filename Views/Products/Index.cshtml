@model IEnumerable<S_ITPE006LA___Activity_5.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Product Inventory</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New Product</a>
</p>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>SKU</th>
            <th>Name</th>
            <th class="text-end">Price</th>
            <th class="text-center">Stock Quantity</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <tr>
                <td><code>@item.SKU</code></td>
                <td><strong>@item.Name</strong></td>
                <td class="text-end">@item.Price.ToString("C")</td>
                <td class="text-center">
                    <span class="badge @(item.StockQuantity > 10 ? "bg-success" : item.StockQuantity > 0 ? "bg-warning text-dark" : "bg-danger")">
                        @item.StockQuantity
                    </span>
                </td>
                <td class="text-center">
                    <a class="btn btn-sm btn-info text-white" asp-action="Details" asp-route-id="@item.Id">Details</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="5" class="text-center text-muted py-4">No products found in the inventory.</td>
        </tr>
    }
    </tbody>
</table>