  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Areas\Enterprise\**\*.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <MvcRazorCompileOnPublish Include="true" />
    <MvcRazorCompileOnUpdate Include="true" />
  </ItemGroup>

